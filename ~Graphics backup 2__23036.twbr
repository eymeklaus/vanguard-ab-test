              <calculation class='tableau' formula='IF [balance] &lt; 50000 THEN &quot;0-50k&quot;&#10;ELSEIF [balance] &lt; 150000 THEN &quot;50-150k&quot;&#10;ELSEIF [balance] &lt; 500000 THEN &quot;150-500k&quot;&#10;ELSEIF [balance] &lt; 1000000 THEN &quot;500k-1M&quot;&#10;ELSEIF [balance] &lt; 5000000 THEN &quot;1M-5M&quot;&#10;ELSE &quot;5M+&quot;&#10;END' />
