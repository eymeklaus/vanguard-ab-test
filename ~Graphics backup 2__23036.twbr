    <worksheet name='Drop-off Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Drop-Out Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vanguard' name='federated.0eu21xg10wgylj13adtgs0df0l8q' />
          </datasources>
          <datasource-dependencies datasource='federated.0eu21xg10wgylj13adtgs0df0l8q'>
            <column caption='agg. drop off' datatype='datetime' name='[Calculation_0907438639648768]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [client_id] : MAX([date_time]) }' />
            </column>
            <column caption='Drop-off' datatype='boolean' name='[Calculation_0907438640381953]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date_time] = [Calculation_0907438639648768]' />
            </column>
            <column caption='Total clients per variation' datatype='integer' name='[Calculation_0907438641438722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [variation] : COUNTD([client_id]) }' />
            </column>
            <column caption='Drop-off rate' datatype='real' name='[Calculation_0907438641643523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([client_id]) /MAX([Calculation_0907438641438722])' />
            </column>
            <column datatype='integer' name='[client_id]' role='measure' type='quantitative' />
            <column datatype='datetime' name='[date_time]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0907438640381953]' derivation='None' name='[none:Calculation_0907438640381953:nk]' pivot='key' type='nominal' />
            <column-instance column='[process_step]' derivation='None' name='[none:process_step:nk]' pivot='key' type='nominal' />
            <column-instance column='[variation]' derivation='None' name='[none:variation:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[process_step]' role='dimension' type='nominal'>
              <aliases>
