                <alias key='&quot;start&quot;' value='Start' />
                <alias key='&quot;step_1&quot;' value='Step 1' />
                <alias key='&quot;step_2&quot;' value='Step 2' />
                <alias key='&quot;step_3&quot;' value='Step 3' />
              </aliases>
            </column>
            <column-instance column='[Calculation_0907438641643523]' derivation='User' name='[usr:Calculation_0907438641643523:qk]' pivot='key' type='quantitative' />
            <column aggregation='CountD' datatype='string' name='[variation]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0eu21xg10wgylj13adtgs0df0l8q].[Action (variation)]'>
